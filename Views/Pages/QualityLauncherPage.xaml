<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WetheringWavesSteamHelper_WinUI.Views.Pages.QualityLauncherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:WetheringWavesSteamHelper_WinUI.Views.Pages"
    mc:Ignorable="d">

    <ScrollViewer Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
        <StackPanel Padding="24" Spacing="16" MaxWidth="1000">

            <!-- 启动器 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="官方启动器" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtLauncherDir" Text="正在检测…" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                    <ComboBox x:Name="cmbCandidates" Header="检测到多个启动器目录" Visibility="Collapsed"
                              HorizontalAlignment="Stretch" SelectionChanged="Candidates_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="btnRedetect" Content="重新检测" Click="Redetect_Click"/>
                        <Button Content="手动选择启动器目录…" Click="BrowseLauncherDir_Click"/>
                        <Button x:Name="btnOpenLauncherDir" Content="打开目录" Click="OpenLauncherDir_Click"/>
                    </StackPanel>
                    <InfoBar x:Name="infoStatus" IsOpen="False" IsClosable="False"/>
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="新版启动器（鸣潮 3.7 起）把 UHD / HD / SD 各档位的游戏目录记录在启动器目录下的 kr_game_cache\kr_game_temp.bin 中。本页读取并可修改这份记录。"/>
                </StackPanel>
            </Border>

            <!-- 画质档位 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="画质档位" FontSize="16" FontWeight="SemiBold"/>
                    <ItemsControl x:Name="tierList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:QualityTierRow">
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="· 启动器当前选中" Visibility="{x:Bind ActiveVisibility}"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind PathText}" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                                       FontFamily="Consolas" FontSize="12"/>
                                            <TextBlock Text="{x:Bind StateText}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="修改…" VerticalAlignment="Center"
                                                IsEnabled="{x:Bind CanEdit}" Tag="{x:Bind Tier}" Click="EditTier_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="btnSetAll" Content="三档统一指向…" Click="SetAll_Click"/>
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="修改前请完全退出启动器（包括右下角托盘图标）。每次写入前自动备份，写入后回读校验，失败自动回滚。本功能只修改「启动器去哪里找游戏」，不会搬运或下载任何资源。"/>
                </StackPanel>
            </Border>

            <!-- 备份与恢复 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="备份与恢复" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="btnBackup" Content="立即备份" Click="Backup_Click"/>
                        <Button x:Name="btnRestore" Content="从备份恢复…" Click="Restore_Click"/>
                        <Button Content="打开备份目录" Click="OpenBackupDir_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 目录联接 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="目录联接（WeGame 等目录名不符时使用）" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="新版启动器「定位游戏」时会在所选目录后强制拼接「Wuthering Waves Game」子目录。若包体目录不叫这个名字（例如 WeGame 的 Wuthering Waves(2002137)），可在其旁边创建一个同名的目录联接指向真实包体，然后在启动器中定位其父目录。"/>
                    <Button Content="选择真实游戏目录并创建联接…" Click="CreateJunction_Click"/>
                </StackPanel>
            </Border>

            <!-- 日志输出 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="运行日志" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="清空" HorizontalAlignment="Right" Click="ClearLog_Click"/>
                    </Grid>
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12" Height="200">
                        <ScrollViewer x:Name="logScrollViewer" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="logList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
